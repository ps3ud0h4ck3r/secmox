{
  "name": "secmox",
  "main": "src/index.js",
  "compatibility_date": "2026-11-01",

  // Static files are served by the assets binding; /api/* goes to the app.
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    // Every request reaches the Worker first so the old workers.dev host can
    // redirect to secmox.com; src/index.js hands non-API paths straight back
    // to the assets.
    "run_worker_first": true
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "secmox",
      "database_id": "ef6fa7c0-b3e5-4778-a098-972218b04e51"
    }
  ],

  "observability": {
    "enabled": true
  }
}
