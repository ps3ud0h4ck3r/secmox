{
  "name": "secmox",
  "main": "src/index.js",
  "compatibility_date": "2026-11-01",

  // Static files are served first; anything with no matching file
  // (every /api/* route) falls through to the Worker.
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "secmox",
      "database_id": "ef6fa7c0-b3e5-4778-a098-972218b04e51"
    }
  ],

  "observability": {
    "enabled": true
  }
}
